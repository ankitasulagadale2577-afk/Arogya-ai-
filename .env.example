# ==============================================================================
# ArogyaMitra AI — Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Exposed to browser via Vite)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://hatrljvgltbjgkcuhtiq.supabase.co 

# Your Supabase Anonymous Public Key (found in Project Settings -> API)
# SAFE to be exposed in browser requests
VITE_SUPABASE_ANON_KEY=sb_publishable_RLq51yZF3uCZKKljdo9oBw_-HtgCFEl

# Optional: Direct Supabase Edge Function URL if deploying to Supabase Edge Functions
# If empty, frontend defaults to local proxy /api/chat
VITE_SUPABASE_FUNCTION_URL=

# ------------------------------------------------------------------------------
# BACKEND SERVER CONFIGURATION (Private — NEVER expose in Vite frontend code)
# ------------------------------------------------------------------------------
# Port for the local secure backend server (default: 5000)
PORT=5000

# Google Gemini API Key for server-side AI health chat & voice assistant
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OR OpenAI API Key (alternative provider)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# MAPS & LOCATION
# ------------------------------------------------------------------------------
# Map tiles & hospital data use OpenStreetMap & Overpass API (no API key required).
# Attribution is preserved automatically in the UI.
